# Database (local Postgres via Docker; use hosted Postgres on Vercel)
DATABASE_URL=postgres://hackathon:hackathon@localhost:5433/hackathon

# BetterAuth (backend; BETTER_AUTH_URL should be the deployed API URL on Vercel)
BETTER_AUTH_SECRET=super-secret-key-change-me
BETTER_AUTH_URL=http://localhost:3001

# Frontend (WEB_URL is used by the API CORS policy; NEXT_PUBLIC_API_URL is built into the web app)
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Teracast AI reports (backend only)
TERACAST_API_KEY=
TERACAST_MODEL=moonshotai/kimi-k2.6
TERACAST_CHAT_COMPLETIONS_URL=https://inference.teracast.net/v1/chat/completions
