{
  "name": "hackathon",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo run build",
    "testbuild": "turbo run typecheck build",
    "smoke:on-tap": "bun --env-file=.env run scripts/smoke-on-tap.ts",
    "dev": "bun run scripts/wait-for-local-db.ts && turbo run dev",
    "dev:api": "bun --env-file=.env --filter api dev",
    "dev:web": "bun --filter web dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio"
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "^5.4.0"
  },
  "packageManager": "bun@1.1.0",
  "engines": {
    "node": ">=20"
  }
}
